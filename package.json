{
  "name": "app-script-starter-kit",
  "private": true,
  "version": "1.0.0",
  "description": "A Google Apps Script web app starter kit, synced to the Apps Script editor via clasp.",
  "scripts": {
    "login": "clasp login",
    "pull": "clasp pull",
    "push": "clasp push --force",
    "watch": "clasp push --force --watch",
    "open": "clasp open --webapp",
    "deploy": "clasp deploy"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.11"
  }
}
